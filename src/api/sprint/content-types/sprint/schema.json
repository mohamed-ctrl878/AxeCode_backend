{
  "kind": "collectionType",
  "collectionName": "sprints",
  "info": {
    "singularName": "sprint",
    "pluralName": "sprints",
    "displayName": "Sprint",
    "description": "Sprint/iteration for project execution"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "project": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project",
      "inversedBy": "sprints"
    },
    "number": {
      "type": "integer",
      "required": true
    },
    "goal": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "planned",
        "active",
        "completed"
      ],
      "default": "planned"
    },
    "start_date": {
      "type": "date"
    },
    "end_date": {
      "type": "date"
    },
    "retrospective_notes": {
      "type": "text"
    }
  }
}
