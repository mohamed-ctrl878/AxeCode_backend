# ===========================================
# AxeCode Backend - STAGING Environment (E2E test runs)
# ===========================================
# This is a TEMPLATE — no real secrets here. The actual .env.staging is
# generated at run time on the self-hosted runner from GitHub Environment
# secrets (see .github/workflows/staging-e2e.yml and
# scripts/run-staging-e2e.sh), and is deleted again once the run finishes.
# Never commit a real .env.staging.

# Server
HOST=0.0.0.0
PORT=1338
PUBLIC_URL=http://localhost:12338
TRUST_PROXY=false

# Secrets — fine to be ephemeral/random per run, nothing depends on these
# persisting across staging runs.
APP_KEYS=CHANGE_ME_KEY1,CHANGE_ME_KEY2,CHANGE_ME_KEY3,CHANGE_ME_KEY4
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME

# Database — matches docker-compose.staging.yml's `db` service.
DATABASE_CLIENT=postgres
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=axecode_staging
DATABASE_USERNAME=axecode_staging
DATABASE_PASSWORD=CHANGE_ME

# Redis — matches docker-compose.staging.yml's `app-redis` service.
REDIS_URL=redis://app-redis:6379

# CORS — the frontend under test, served locally on the same runner.
CORS_ORIGIN=http://localhost:4173
FRONTEND_URL=http://localhost:4173
COOKIE_DOMAIN=

# reCAPTCHA — Google's PUBLIC test key pair. Always verifies instantly
# with no real challenge. This is the documented, intended use for exactly
# this scenario (automated E2E testing) — NEVER use this pair anywhere
# reachable by real users.
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_REQUIRED=true
RECAPTCHA_MIN_SCORE=0.5

# Judge0 — matches docker-compose.staging.yml's judge0-api service.
JUDGE0_API_URL=http://judge0-api:2358

# Everything below is only needed if a given E2E scenario exercises it.
# Leave blank to skip those scenarios rather than using fake values that
# would just fail confusingly instead of skipping cleanly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:staging@axecode.local
PAYMOB_HMAC_SECRET=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_WEBHOOK_SECRET=
KASHIER_MODE=test
